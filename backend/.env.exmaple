# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/recruitment_db

# ── Auth ───────────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Recruitment logic ──────────────────────────────────────────────────────────
# Candidates with overall_score >= MATCH_THRESHOLD are shortlisted (0.0 - 1.0)
MATCH_THRESHOLD=0.8

# ── Groq LLM ──────────────────────────────────────────────────────────────────
# Used by: JDSummarizerAgent, InterviewSchedulerAgent
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
# Model options (free tier):
#   llama-3.1-8b-instant   — fastest, default
#   llama-3.3-70b-versatile — higher quality, slightly slower
GROQ_MODEL=llama-3.1-8b-instant
